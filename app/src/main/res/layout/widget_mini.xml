<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 widget: builders count + Sync, then the next jobs to finish (icon + countdown).
     Rows are added at runtime (widget_row_mini.xml). Tap = open Clash, Sync = sync. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/mini_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_panel"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/mini_title"
                style="@style/WidgetText.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:text="BUILDERS"
                android:textSize="11dp" />

            <FrameLayout
                android:id="@+id/mini_sync"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/btn_sync">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_sync" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mini_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/mini_empty"
            style="@style/WidgetText.Footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:singleLine="false"
            android:text="Copy village data in Clash, then tap Sync"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
