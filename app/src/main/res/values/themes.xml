<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ClashTimer" parent="android:Theme.Material.Light.NoActionBar" />
    <!-- The screen draws its own Material You colors; the system's "force dark" must not invert only its
         background (that left dark text on a black screen). Night mode swaps in a dark window, see values-night. -->
    <style name="Theme.ClashTimer.Config" parent="Theme.ClashTimer">
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <!-- SyncActivity: invisible, no window animation, so tapping Sync looks like nothing opened. -->
    <style name="Theme.ClashTimer.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
