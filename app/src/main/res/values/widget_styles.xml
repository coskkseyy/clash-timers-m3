<?xml version="1.0" encoding="utf-8"?>
<!-- Widget text styles (Material You). Sizes are in dp, not sp, so the fixed layout
     looks the same regardless of the phone's font size setting. Colors live in m_colors.xml. -->
<resources>
    <!-- Kept so older references still resolve; the widget itself uses m_* colors. -->
    <color name="w_white">@color/m_on</color>
    <color name="w_gold">@color/m_primary</color>
    <color name="w_sub">@color/m_sub</color>
    <color name="w_goblin">@color/m_tertiary</color>
    <color name="w_idle">@color/m_tertiary</color>
    <color name="w_error">@color/m_error</color>
    <color name="w_sync_text">@color/m_on_primary</color>

    <!-- System font, no shadows. -->
    <style name="WidgetText">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/m_on</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="WidgetText.Name">
        <item name="android:textSize">13.5dp</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetText.Level">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11dp</item>
        <item name="android:textColor">@color/m_sub</item>
    </style>

    <style name="WidgetText.Time">
        <item name="android:textSize">13dp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="WidgetText.Section">
        <item name="android:textSize">12dp</item>
        <item name="android:textColor">@color/m_primary</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="WidgetText.Pill">
        <item name="android:textSize">11dp</item>
        <item name="android:textColor">@color/m_on_pill</item>
    </style>

    <style name="WidgetText.Footer">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">11dp</item>
        <item name="android:textColor">@color/m_sub</item>
    </style>

    <style name="WidgetSmallSans">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
