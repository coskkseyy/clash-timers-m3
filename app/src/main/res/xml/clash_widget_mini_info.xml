<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2: next jobs to finish. Resizable; taller shows more rows. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_mini_description"
    android:initialLayout="@layout/widget_mini"
    android:previewLayout="@layout/widget_mini"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="90dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:configure="com.kuswa.clashtimer.widget.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
